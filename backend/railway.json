{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "startCommand": "python manage.py migrate --noinput && gunicorn config.wsgi:application --timeout 300",
        "restartPolicyType": "ON_FAILURE",
        "numReplicas": 1
    }
}